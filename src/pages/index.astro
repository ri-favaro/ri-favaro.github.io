---
import Layout from '../layouts/Layout.astro';
import Controls from '../components/Controls.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { content, skillsList, socialLinks } from '../data/translations';
import { projects } from '../data/projects';
---

<Layout>
  <Controls />

  <main class="container">
    <!-- Hero Section -->
    <section class="hero" id="hero">
      <div class="hero-avatar-wrapper">
        <img
          class="hero-photo"
          src="/avatar.jpg"
          alt="Foto de Luiz Ricardo Favaro"
          width="128"
          height="128"
          loading="eager"
        />
      </div>
      <h1>Luiz Ricardo Favaro</h1>
      <p class="role">
        <span data-lang="pt">{content.pt.hero.role}</span>
        <span data-lang="en">{content.en.hero.role}</span>
      </p>
      <p class="bio">
        <span data-lang="pt">{content.pt.hero.bio}</span>
        <span data-lang="en">{content.en.hero.bio}</span>
      </p>
      <div class="social-links">
        {socialLinks.map((item) => (
          <a
            href={item.url}
            target={item.url.startsWith('mailto') ? '_self' : '_blank'}
            rel={item.url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
          >
            {item.label}
          </a>
        ))}
      </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
      <h2>
        <span data-lang="pt">{content.pt.about.heading}</span>
        <span data-lang="en">{content.en.about.heading}</span>
      </h2>
      <ul class="about-list">
        {content.pt.about.items.map((item, index) => (
          <li>
            <span data-lang="pt">{item}</span>
            <span data-lang="en">{content.en.about.items[index]}</span>
          </li>
        ))}
      </ul>

      <h3 class="skills-heading">
        <span data-lang="pt">{content.pt.about.skillsHeading}</span>
        <span data-lang="en">{content.en.about.skillsHeading}</span>
      </h3>
      <div class="skills-tags">
        {skillsList.map((skill) => (
          <span>{skill}</span>
        ))}
      </div>

      <!-- Agent Skills Showcase Banner -->
      <aside class="agent-skills-banner" aria-label="Playbook de Engenharia com Agentes">
        <div class="agent-skills-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span data-lang="pt">NOVO • WORKFLOWS COM AGENTES</span>
          <span data-lang="en">NEW • AGENT WORKFLOWS</span>
        </div>
        <div class="agent-skills-content">
          <h4>
            <span data-lang="pt">Como Utilizo Agentes de Código no Dia a Dia</span>
            <span data-lang="en">How I Build with AI Code Agents</span>
          </h4>
          <p>
            <span data-lang="pt">Playbook prático baseado no ecossistema pstack de <strong>Lauren Tan (@poteto)</strong>: 34 skills operacionais, 24 princípios de engenharia, grafo interativo e testes reais.</span>
            <span data-lang="en">Practical playbook based on <strong>Lauren Tan's (@poteto)</strong> pstack ecosystem: 34 operational skills, 24 engineering principles, interactive graph, and real tests.</span>
          </p>
        </div>
        <a href="/skills" class="agent-skills-link">
          <span data-lang="pt">Explorar Playbook &amp; Skills &rarr;</span>
          <span data-lang="en">Explore Playbook &amp; Skills &rarr;</span>
        </a>
      </aside>
    </section>

    <!-- Projects Section -->
    <section class="projects" id="projects">
      <h2>
        <span data-lang="pt">{content.pt.projects.heading}</span>
        <span data-lang="en">{content.en.projects.heading}</span>
      </h2>

      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <p class="footer-heading">
      <span data-lang="pt">{content.pt.footer.heading}</span>
      <span data-lang="en">{content.en.footer.heading}</span>
    </p>
    <div class="social-links">
      {socialLinks.map((item) => (
        <a
          href={item.url}
          target={item.url.startsWith('mailto') ? '_self' : '_blank'}
          rel={item.url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
        >
          {item.label}
        </a>
      ))}
    </div>
    <p class="copyright">
      <span data-lang="pt">{content.pt.footer.copyright}</span>
      <span data-lang="en">{content.en.footer.copyright}</span>
    </p>
  </footer>
</Layout>
